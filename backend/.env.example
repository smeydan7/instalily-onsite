# Copy to .env and fill in.
APP_NAME="Roofing Sales Intelligence"
ENVIRONMENT=local
DEBUG=true

# Postgres. For local docker-compose the default below works as-is.
DATABASE_URL=postgresql+psycopg://sales:sales@localhost:5432/sales_intel

# CORS — comma-separated origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:5173

# Data source credentials go here once a source is chosen (API keys, etc.)
# EXAMPLE_SOURCE_API_KEY=
