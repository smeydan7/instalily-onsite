# Copy to .env and fill in.
APP_NAME="Roofing Sales Intelligence"
ENVIRONMENT=local
DEBUG=true

# Postgres. For local docker-compose the default below works as-is.
DATABASE_URL=postgresql+psycopg://sales:sales@localhost:5432/sales_intel

# CORS — comma-separated origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- GAF / Coveo data source ---
# Public search tokens shipped by GAF's own browser frontend (not real secrets).
# Defaults are baked into config; override here only to rotate or point elsewhere.
# COVEO_ORG_ID=gafmaterialscorporationproduction3yalqk12
# COVEO_API_KEY=xx3cfe6ca4-11f2-45b6-83ad-41e053e06504
# COVEO_DEFAULT_ZIP=10013
# COVEO_DEFAULT_RADIUS_MILES=25
# COVEO_TIMEOUT_SECONDS=15
